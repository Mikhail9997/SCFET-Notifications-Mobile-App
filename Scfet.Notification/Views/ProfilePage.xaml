<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scfet.Notification.Views.ProfilePage"
             xmlns:vm="clr-namespace:Scfet.Notification.ViewModels"
             xmlns:models="clr-namespace:Scfet.Notification.Models"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:DataType="vm:ProfileViewModel"
             Title="Профиль">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="frame" TargetType="Border">
                <Setter Property="BackgroundColor">
                    <Setter.Value>
                        <AppThemeBinding Light="#F0F0F0"
                           Dark="#2A2A2A" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>

        <Grid>
            <!-- Состояние загрузки -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50"
                               Color="{StaticResource PrimaryColor}"/>

            <Grid IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">

                <StackLayout HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         IsVisible="{Binding IsCurrentUserEnable, Converter={StaticResource InverseBoolConverter}}">

                    <Image Source="no_wifi.png" HeightRequest="200" WidthRequest="200" Margin="0,0,0,70"/>
                    <Label Text="Не удалось загрузить профиль" FontSize="16"/>
                    <Label Text="Проверьте подключение к интернету" FontSize="16"/>
                    <Button Text="Перезагрузить"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="White"
                            CornerRadius="5"
                            Margin="0,10,0,0"/>
                </StackLayout>

                <VerticalStackLayout Spacing="20" Padding="20" 
                                     IsVisible="{Binding IsCurrentUserEnable}">

                    <!-- Информация о пользователе -->
                    <Border  Padding="15"
                             Style="{StaticResource frame}">
                          
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">
                            <!-- Аватарка -->
                            <Border Style="{StaticResource avatar}">
                                <ff:CachedImage 
                                    Source="{Binding CurrentUser.AvatarUrl}"
                                    Aspect="AspectFill"
                                    DownsampleToViewSize="True"
                                    FadeAnimationEnabled="False"
                                    LoadingPlaceholder="placeholder.png"
                                    ErrorPlaceholder="placeholder.png"
                                    RetryCount="2">
                                </ff:CachedImage>
                            </Border>
                            <Button Text="Изменить"
                                    FontSize="14" 
                                    WidthRequest="150"
                                    TextColor="White"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    Command="{Binding GoToAvatarsPageCommand}"
                                    CommandParameter="{Binding CurrentUser.AvatarUrl}"/>
                            
                            <!-- Имя и Фамилия -->
                            <Label Text="{Binding CurrentUser.FullName}" 
                                   FontSize="20" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center"/>
                            
                            <!-- Роль с цветным фоном -->
                            <Border BackgroundColor="{Binding CurrentUser.Role, Converter={StaticResource RoleToColorConverter}}"
                                    Padding="8,3"
                                    StrokeThickness="0"
                                    WidthRequest="150"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding CurrentUser.Role, Converter={StaticResource RoleToRussianConverter}}"
                                       FontSize="13"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       FontAttributes="Bold"/>
                            </Border>
                            <Label Text="{Binding CurrentUser.Group, StringFormat='Группа: {0}'}" 
                                   HorizontalOptions="Center"
                                   FontSize="14" 
                                   IsVisible="{Binding CurrentUser.Group, Converter={StaticResource StringNotEmptyConverter}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Редактирование профиля -->
                    <Border 
                            Padding="15"
                            IsVisible="{Binding CanSendNotifications}"
                            Style="{StaticResource frame}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="15">
                            <Label Text="Редактировать профиль" 
                                   FontSize="16" 
                                   FontAttributes="Bold" />

                            <Entry Placeholder="Имя" 
                                   Text="{Binding FirstName}" />

                            <Entry Placeholder="Фамилия" 
                                   Text="{Binding LastName}" />

                            <Entry Placeholder="Email" 
                                   Text="{Binding Email}"
                                   Keyboard="Email" />
                            
                            <Entry Placeholder="Номер телефона" 
                                   Text="{Binding Phone}"
                                   Keyboard="Email" />

                            <Button Text="Обновить профиль" 
                                    Command="{Binding UpdateProfileCommand}"
                                    BackgroundColor="#2E86AB"
                                    TextColor="White"
                                    CornerRadius="10" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Действия -->
                    <VerticalStackLayout Spacing="10">
                        <Button Text="Сменить пароль" 
                                Command="{Binding ChangePasswordCommand}"
                                BackgroundColor="#A23B72"
                                TextColor="White"
                                CornerRadius="10" />

                        <Button Text="Создать уведомление" 
                                Command="{Binding GoToCommand}"
                                CommandParameter="CreateNotificationPage"
                                BackgroundColor="#F18F01"
                                TextColor="White"
                                CornerRadius="10"
                                IsVisible="{Binding CanSendNotifications}" />

                        <Button Text="Мои отправленные уведомления" 
                                Command="{Binding GoToCommand}"
                                CommandParameter="SentNotificationsPage"
                                BackgroundColor="#C73E1D"
                                TextColor="White"
                                CornerRadius="10"
                                IsVisible="{Binding CanSendNotifications}" />

                        <Border IsVisible="{Binding IsCacheEnable}"
                                HeightRequest="50"
                                BackgroundColor="Coral">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,Auto"                                 
                                  ColumnSpacing="5"
                                  HorizontalOptions="Center">

                                <Label Text="Очистить кэш приложения:"                                   
                                        TextColor="White"
                                        Grid.Column="0"
                                        BackgroundColor="Coral"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                <Label Text="{Binding CacheSize}"
                                       Grid.Column="1"
                                       TextColor="White"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CleanCacheCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Button Text="Выйти" 
                                Command="{Binding LogoutCommand}"
                                BackgroundColor="#FF6B6B"
                                TextColor="White"
                                CornerRadius="10" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>