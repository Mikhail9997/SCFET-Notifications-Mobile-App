<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scfet.Notification.Views.RepliesPage"
             xmlns:vm="clr-namespace:Scfet.Notification.ViewModels"
             xmlns:models="clr-namespace:Scfet.Notification.Models"
             xmlns:converters="clr-namespace:Scfet.Notification.Converters"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:DataType="vm:RepliesViewModel"
             Title="Обсуждение">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="frame" TargetType="Border">
                <Setter Property="BackgroundColor">
                    <Setter.Value>
                        <AppThemeBinding Light="#F0F0F0"
                           Dark="#2A2A2A" />
                    </Setter.Value>
                </Setter>
            </Style>

            <converters:IsReplyActionsEnableConverter x:Key="IsReplyActionsEnableConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Ошибка загрузки уведомлений -->
        <StackLayout HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         IsVisible="{Binding IsStartLoadRepliesFailed}">

            <Image Source="no_wifi.png" HeightRequest="200" WidthRequest="200" Margin="0,0,0,70"/>
            <Label Text="Не удалось загрузить ответы" FontSize="16"/>
            <Label Text="Проверьте подключение к интернету" FontSize="16"/>
            <Button Text="Перезагрузить"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="White"
                    CornerRadius="5"
                    Margin="0,10,0,0"/>
        </StackLayout>

        <!-- Состояние загрузки -->
        <VerticalStackLayout IsVisible="{Binding IsStartLoadRepliesFailed, Converter={StaticResource InverseBoolConverter}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Spacing="20">

            <StackLayout IsVisible="{Binding IsBusy}">
                <ActivityIndicator IsRunning="True" 
                             Color="{StaticResource PrimaryColor}"
                             HeightRequest="50"
                             WidthRequest="50" />
                <Label Text="Загрузка ответов..." 
                               FontSize="16"
                               HorizontalOptions="Center" />
            </StackLayout>
        </VerticalStackLayout>

        <!-- Основной контент -->
        <ScrollView x:Name="MainScrollView"
                    IsVisible="{Binding IsStartLoadRepliesFailed, Converter={StaticResource InverseBoolConverter}}">
            <StackLayout Padding="10,0">

                <StackLayout Spacing="20"
                             x:Name="contentLayout"
                             IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    
                    <!-- Информация об уведомлении -->
                    <Border Style="{StaticResource frame}"
                            Padding="10">
                        
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5"/>
                        </Border.StrokeShape>

                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,auto,auto">
                                <!-- Метка личного сообщения-->
                                <Border IsVisible="{Binding IsPersonal}"
                                         BackgroundColor="#FFE5E5"
                                         Padding="8,3"
                                         StrokeThickness="0"
                                         HorizontalOptions="Start"
                                         VerticalOptions="Center"
                                         Grid.Column="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="🔒" FontSize="9"/>
                                        <Label Text="личное"
                                                FontSize="9"
                                                TextColor="{AppThemeBinding Light='#E74C3C', Dark='#FF8A7A'}"
                                                FontAttributes="Bold"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Дата -->
                                <Label Grid.Column="1" 
                                        Text="{Binding CreatedAt, Converter={StaticResource RelativeTimeConverter}}" 
                                        FontSize="12"
                                        VerticalOptions="Center"/>

                                <!-- Закладка -->
                                <ImageButton Grid.Column="2"
                                          Source="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteIconConverter}}"
                                          WidthRequest="15"
                                          HeightRequest="15"
                                          BackgroundColor="Transparent"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                            Path=ToggleFavoriteCommand}"
                                          CommandParameter="{Binding .}"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"
                                          Padding="8"/>
                            </Grid>
                            
                            <!-- Отправитель -->
                            <Grid 
                                ColumnSpacing="3"
                                VerticalOptions="Center"
                                ColumnDefinitions="auto,auto,auto,auto,auto"
                                RowDefinitions="*,*">

                                <!-- Аватар/иконка -->
                                <Border BackgroundColor="#E8F0FE"
                                        Style="{StaticResource card_avatar}"
                                        HorizontalOptions="Start"
                                        Grid.Column="0"
                                        Grid.Row="0">
                                    <ff:CachedImage 
                                            Source="{Binding SenderAvatarUrl}"
                                            Aspect="AspectFill"
                                            DownsampleToViewSize="True"
                                            FadeAnimationEnabled="False"
                                            LoadingPlaceholder="placeholder.png"
                                            ErrorPlaceholder="placeholder.png"
                                            RetryCount="2">
                                    </ff:CachedImage>
                                </Border>

                                <!-- Имя отправителя -->
                                <Label Text="{Binding SenderName}" 
                                        FontSize="12" 
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light='#2C3E50', Dark='#ECF0F1'}"
                                        VerticalOptions="Center"
                                        MaximumWidthRequest="170"
                                        LineBreakMode="TailTruncation"
                                       Grid.Column="0"
                                       Grid.Row="1"/>

                                <!-- Разделитель -->
                                <Label Text="·" 
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light='#BDC3C7', Dark='#7F8C8D'}"
                                        VerticalOptions="Center"
                                       Grid.Column="2"
                                       Grid.Row="1"/>

                                <!-- Роль с цветным фоном -->
                                <Border BackgroundColor="{Binding SenderRole, Converter={StaticResource RoleToColorConverter}}"
                                        Padding="8,3"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Grid.Column="3"
                                        Grid.Row="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding SenderRole, Converter={StaticResource RoleToRussianConverter}}"
                                            FontSize="10"
                                            TextColor="White"
                                            FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <!-- Изображение -->
                            <ff:CachedImage 
                                Source="{Binding ImageUrl}"
                                HeightRequest="350"
                                IsVisible="{Binding ImageUrl, Converter={StaticResource StringNotEmptyConverter}}"
                                DownsampleToViewSize="True"
                                FadeAnimationEnabled="False"
                                LoadingPlaceholder="placeholder.png"
                                ErrorPlaceholder="placeholder.png"
                                RetryCount="2">
                            </ff:CachedImage>

                            <!-- Заголовок -->
                            <Label 
                                    Text="{Binding Title}" 
                                    FontSize="16" 
                                    FontAttributes="Bold" />

                            <!-- Сообщение -->
                            <Label 
                                    Text="{Binding Message}" 
                                    FontSize="14" 
                                    LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Border>
                    
                    <!-- Фильтрация-->
                    <Border 
                        Style="{StaticResource frame}"
                        Padding="10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Фильтрация:" 
                                    FontSize="14" 
                                    FontAttributes="Bold" />

                            <Picker Title="Размер страницы"
                                    ItemsSource="{Binding PageSizes}"
                                    SelectedItem="{Binding Filter.PageSize}" />

                            <Picker Title="Упорядочить:" 
                                    ItemsSource="{Binding SortOrderItems}"
                                    SelectedItem="{Binding SelectedSortOrder}"
                                        ItemDisplayBinding="{Binding DisplayName}"/>

                            <Picker Title="Выберите период"
                                    ItemsSource="{Binding DateRangeOptions}"
                                    SelectedItem="{Binding SelectedDateRange}"
                                    ItemDisplayBinding="{Binding DisplayName}"/>

                            <Grid ColumnDefinitions="Auto,Auto" 
                                    ColumnSpacing="5"
                                    IsVisible="{Binding ShowCustomDateInput}">
                                <StackLayout Grid.Column="0" Padding="10">
                                    <Label Text="С:"/>
                                    <DatePicker Date="{Binding SelectedStartDate}"/>
                                </StackLayout>
                                <StackLayout Grid.Column="1" Padding="10">
                                    <Label Text="По:"/>
                                    <DatePicker Date="{Binding SelectedEndDate}"/>
                                </StackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Применить фильтр"
                                    Command="{Binding ApplyFiltersCommand}"
                                    BackgroundColor="#2E86AB"
                                    TextColor="White"
                                    CornerRadius="5"
                                    HorizontalOptions="FillAndExpand"
                                    IsEnabled="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Text="Сбросить"
                                    Command="{Binding ResetFiltersCommand}"
                                    BackgroundColor="#6c757d"
                                    TextColor="White"
                                    CornerRadius="5"
                                    HorizontalOptions="FillAndExpand"
                                    IsEnabled="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Форма Ответа -->
                    <Border 
                        Style="{StaticResource frame}"
                        Padding="10">

                        <StackLayout Spacing="8">
                            <StackLayout>
                                <!-- Сообщение -->
                                <Editor Text="{Binding ReplyMessage}"
                                        Placeholder="Введите сообщение..."
                                        HeightRequest="120"
                                        MaxLength="1000"
                                        AutoSize="TextChanges"/>
                                <HorizontalStackLayout 
                                        IsVisible="{Binding ReplyMessage.Length, Converter={StaticResource IsNotZeroConverter}}">
                                    <Label Text="{Binding ReplyMessage.Length}"
                                           TextColor="{Binding ReplyMessage.Length, 
                                       Converter={StaticResource CounterColorConverter}, 
                                       ConverterParameter=1000}"/>
                                    <Label Text="/"
                                            TextColor="{Binding ReplyMessage.Length, 
                                      Converter={StaticResource CounterColorConverter}, 
                                      ConverterParameter=1000}"/>
                                    <Label Text="1000"
                                           TextColor="{Binding ReplyMessage.Length, 
                                         Converter={StaticResource CounterColorConverter}, 
                                         ConverterParameter=1000}"/>
                                </HorizontalStackLayout>

                            </StackLayout>

                            <!-- Индикатор загрузки -->
                            <ActivityIndicator IsVisible="{Binding IsReplyCreation}"
                              IsRunning="{Binding IsReplyCreation}"
                              HorizontalOptions="Center"
                              Color="{StaticResource PrimaryColor}"/>

                            <!-- Кнопка отправки -->
                            <Button Command="{Binding CreateReplyCommand}"
                                    Text="Отправить"
                                    TextColor="White"
                                    VerticalOptions="Start"
                                    HorizontalOptions="Start"
                                    Margin="0,20,0,0"
                                    IsEnabled="{Binding IsReplyCreation, Converter={StaticResource InverseBoolConverter}}"
                                    BackgroundColor="{StaticResource PrimaryColor}"/>
                        </StackLayout>
                    </Border>

                    <!-- Список ответов -->
                    <CollectionView ItemsSource="{Binding Replies}"
                                    SelectionMode="None">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" 
                                        VerticalOptions="Center"
                                        Spacing="20">
                                <Label Text="📭" 
                                        FontSize="48" 
                                        HorizontalOptions="Center" />
                                <Label Text="Нет ответов" 
                                        FontSize="18" 
                                    HorizontalOptions="Center" />
                                <Label Text="Здесь будут появляться новые ответы от пользователей" 
                                    FontSize="14" 
                                        TextColor="Gray"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Reply">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItem Text="Удалить" 
                                                    BackgroundColor="Red"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                            Path=RemoveReplyCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                            Path=IsReplyRemoving, Converter={StaticResource InverseBoolConverter}}">
                                            <SwipeItem.IsVisible>
                                                <MultiBinding Converter="{StaticResource IsReplyActionsEnableConverter}">
                                                    <Binding Source="{RelativeSource AncestorType={x:Type vm:RepliesViewModel}}" 
                                                            Path="CurrentUserId"/>
                                                    <Binding Path="UserId"/>
                                                    <Binding Source="{RelativeSource AncestorType={x:Type vm:RepliesViewModel}}" 
                                                            Path="NotificationSenderId"/>
                                                </MultiBinding>
                                            </SwipeItem.IsVisible>
                                        </SwipeItem>
                                        <SwipeItem Text="Изменить" 
                                                    BackgroundColor="Orange"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                            Path=StartReplyUpdateProcessCommand}"
                                                    CommandParameter="{Binding .}" >
                                            <SwipeItem.IsVisible>
                                                <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                    <Binding Source="{RelativeSource AncestorType={x:Type vm:RepliesViewModel}}" 
                                                            Path="CurrentUserId"/>
                                                    <Binding Path="UserId"/>
                                                </MultiBinding>
                                            </SwipeItem.IsVisible>
                                        </SwipeItem>
                                                       
                                    </SwipeView.RightItems>
                                    <Border Padding="15" 
                                            Margin="10,5"
                                            Style="{StaticResource CardThemeStyle}">

                                        <Border.Stroke>
                                            <MultiBinding Converter="{StaticResource BorderStrokeToColorConverter}">
                                                <Binding Source="{RelativeSource AncestorType={x:Type vm:RepliesViewModel}}" 
                                                     Path="CurrentUserId"/>
                                                <Binding Path="UserId"/>
                                            </MultiBinding>
                                        </Border.Stroke>

                                        <Grid RowDefinitions="Auto, Auto"
                                              ColumnDefinitions="*, auto"
                                              RowSpacing="5">

                                            <!-- Отправитель -->
                                            <Grid 
                                                Grid.Row="0" 
                                                Grid.ColumnSpan="2"
                                                ColumnSpacing="3"
                                                VerticalOptions="Center"
                                                ColumnDefinitions="auto,auto,auto,auto,auto"
                                                RowDefinitions="*,*">

                                                <!-- Аватар/иконка -->
                                                <Border BackgroundColor="#E8F0FE"
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource card_avatar}"
                                                        Grid.Column="0"
                                                        Grid.Row="0">
                                                    <ff:CachedImage 
                                                           Source="{Binding UserAvatarUrl}"
                                                           Aspect="AspectFill"
                                                           DownsampleToViewSize="True"
                                                           FadeAnimationEnabled="False"
                                                           LoadingPlaceholder="placeholder.png"
                                                           ErrorPlaceholder="placeholder.png"
                                                           RetryCount="2">
                                                    </ff:CachedImage>
                                                </Border>

                                                <!-- Имя отправителя -->
                                                <Label Text="{Binding UserName}" 
                                                        FontSize="11" 
                                                        FontAttributes="Bold"
                                                        TextColor="{AppThemeBinding Light='#2C3E50', Dark='#ECF0F1'}"
                                                        VerticalOptions="Center"
                                                         MaximumWidthRequest="170"
                                                         LineBreakMode="TailTruncation"
                                                       Grid.Column="0"
                                                       Grid.Row="1"/>

                                                <!-- Разделитель -->
                                                <Label Text="·" 
                                                        FontSize="14"
                                                        TextColor="{AppThemeBinding Light='#BDC3C7', Dark='#7F8C8D'}"
                                                        VerticalOptions="Center"
                                                       Grid.Column="2"
                                                       Grid.Row="1"/>

                                                <!-- Роль с цветным фоном -->
                                                <Border BackgroundColor="{Binding UserRole, Converter={StaticResource RoleToColorConverter}}"
                                                        Padding="8,3"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        Grid.Column="3"
                                                        Grid.Row="1">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding UserRole, Converter={StaticResource RoleToRussianConverter}}"
                                                            FontSize="10"
                                                            TextColor="White"
                                                            FontAttributes="Bold"/>
                                                </Border>

                                                <!-- Бейдж владельца уведомления -->
                                                <Label Text="👑"
                                                       FontSize="12"
                                                       VerticalOptions="Center"
                                                       Grid.Column="4"
                                                       Grid.Row="1">

                                                    <Label.IsVisible>
                                                        <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                            <Binding Source="{RelativeSource AncestorType={x:Type vm:RepliesViewModel}}" 
                                                                Path="NotificationSenderId"/>
                                                            <Binding Path="UserId"/>
                                                        </MultiBinding>
                                                    </Label.IsVisible>
                                                </Label>
                                            </Grid>

                                            <!-- Дата -->
                                            <Label Grid.Row="0" 
                                                    Grid.Column="1"
                                                    Text="{Binding CreatedAt, Converter={StaticResource RelativeTimeConverter}}" 
                                                    FontSize="12" />

                                            <!-- Сообщение -->
                                            <Label Grid.Row="1" 
                                                    Grid.ColumnSpan="2"
                                                    Text="{Binding Message}" 
                                                    FontSize="14" 
                                                    LineBreakMode="WordWrap">
                                                <Label.IsVisible>
                                                    <MultiBinding Converter="{StaticResource IsNotEqualConverter}">
                                                        <Binding Source="{RelativeSource AncestorType={x:Type vm:RepliesViewModel}}" Path="EditingReplyId"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </Label.IsVisible>
                                            </Label>
                                            
                                            <!-- Форма редактирования сообщения -->
                                            <Border 
                                                    Grid.Row="2"
                                                    Grid.ColumnSpan="2">
                                                
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                        <Binding Source="{RelativeSource AncestorType={x:Type vm:RepliesViewModel}}" Path="EditingReplyId"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                
                                                <StackLayout Spacing="5"
                                                             Padding="20">
                                                    <StackLayout>
                                                        <!-- Сообщение -->
                                                        <Editor Text="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                            Path=EditingMessage}"
                                                            Placeholder="Введите сообщение..."
                                                            AutoSize="TextChanges"
                                                            HeightRequest="120"
                                                            MaxLength="1000"/>
                                                        <HorizontalStackLayout 
                                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                 Path=EditingMessage.Length, Converter={StaticResource IsNotZeroConverter}}">
                                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                  Path=EditingMessage.Length}"
                                                                  TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                            Path=EditingMessage.Length, 
                                                                            Converter={StaticResource CounterColorConverter}, 
                                                                            ConverterParameter=1000}"/>
                                                            <Label Text="/"
                                                                   TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                            Path=EditingMessage.Length, 
                                                                            Converter={StaticResource CounterColorConverter}, 
                                                                            ConverterParameter=1000}"/>
                                                            <Label Text="1000"
                                                                    TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                               Path=EditingMessage.Length, 
                                                                               Converter={StaticResource CounterColorConverter}, 
                                                                               ConverterParameter=1000}"/>
                                                        </HorizontalStackLayout>

                                                    </StackLayout>

                                                    <!-- Индикатор загрузки -->
                                                    <ActivityIndicator IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                                  Path=IsReplyUpdating}"
                                                                      IsRunning="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                                  Path=IsReplyUpdating}"
                                                                      HorizontalOptions="Center"
                                                                      Color="{StaticResource PrimaryColor}"/>

                                                    <!-- Кнопка -->
                                                    <Button Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, 
                                                                    Path=UpdateReplyCommand}"
                                                        Text="Обновить"
                                                        TextColor="White"
                                                        CornerRadius="10"
                                                        Margin="0,20,0,0"
                                                        IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:RepliesViewModel}}, Path=IsReplyUpdating, Converter={StaticResource InverseBoolConverter}}"
                                                        BackgroundColor="{StaticResource PrimaryColor}"/>
                                                </StackLayout>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Действия -->
                <Grid IsVisible="{Binding IsPaginationEnable}">

                    <!-- Состояние загрузки пагинации-->
                    <VerticalStackLayout IsVisible="{Binding IsPagination}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Spacing="20">
                        <ActivityIndicator IsRunning="True" 
                                                    Color="{StaticResource PrimaryColor}"
                                                    HeightRequest="50"
                                                    WidthRequest="50" />
                        <Label Text="Загрузка уведомлений..." 
                                       FontSize="16"
                                       HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Кнопка Загрузить еще -->
                    <Grid Margin="0,10,0,0" ColumnDefinitions="*"
                                 IsVisible="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}">

                        <Button Grid.Column="0" 
                                        Text="Загрузить еще" 
                                        TextColor="{AppThemeBinding Light=White, Dark=White}"
                                        Command="{Binding LoadRepliesPaginationCommand}"
                                        BackgroundColor="#2E86AB"/>
                    </Grid>
                </Grid>
            </StackLayout>
        </ScrollView>

        <!-- Контейнер для плавающих кнопок -->
        <VerticalStackLayout
                        VerticalOptions="End"
                        HorizontalOptions="End"
                        Margin="20"
                        Spacing="10"
                        IsVisible="{Binding IsShowScrollButtons}">

            <!-- Кнопка вверх -->
            <Button 
                x:Name="scrollToTopButton"
                Text="↑"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{StaticResource PrimaryColor}"
                TextColor="White"
                FontSize="20"
                IsVisible="false"/>

            <!-- Кнопка вниз -->
            <Button 
                x:Name="scrollToBottomButton"
                Text="↓"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{StaticResource PrimaryColor}"
                FontSize="20"
                TextColor="White"
                IsVisible="False"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>