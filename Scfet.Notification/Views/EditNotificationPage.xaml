<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scfet.Notification.Views.EditNotificationPage"
             xmlns:vm="clr-namespace:Scfet.Notification.ViewModels"
             xmlns:models="clr-namespace:Scfet.Notification.Models"
             xmlns:views="clr-namespace:Scfet.Notification.Views"
             xmlns:converters="clr-namespace:Scfet.Notification.Converters"
             x:DataType="vm:EditNotificationViewModel"
             Title="Изменить">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="frame" TargetType="Border">
                <Setter Property="BackgroundColor">
                    <Setter.Value>
                        <AppThemeBinding Light="#F0F0F0"
                           Dark="#2A2A2A" />
                    </Setter.Value>
                </Setter>
            </Style>

            <converters:RoleToRussianConverter x:Key="RoleToRussianConverter"/>
            <converters:IsStudentRoleConverter x:Key="IsStudentRoleConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Ошибка загрузки уведомлений -->
        <StackLayout HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         IsVisible="{Binding IsInitializeFailed}">

            <Image Source="no_wifi.png" HeightRequest="200" WidthRequest="200" Margin="0,0,0,70"/>
            <Label Text="Не удалось загрузить уведомления" FontSize="16"/>
            <Label Text="Проверьте подключение к интернету" FontSize="16"/>
            <Button Text="Перезагрузить"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#2E86AB"
                    TextColor="White"
                    CornerRadius="5"
                    Margin="0,10,0,0"/>
        </StackLayout>

        <!-- Состояние загрузки -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Spacing="20">
            <ActivityIndicator IsRunning="True" 
                             Color="#2E86AB"
                             HeightRequest="50"
                             WidthRequest="50" />
            <Label Text="Загрузка..." 
                               FontSize="16"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Основной контент -->
        <ScrollView IsVisible="{Binding IsInitializeFailed, Converter={StaticResource InverseBoolConverter}}">
            
            <VerticalStackLayout Spacing="15" 
                                 Padding="20"
                                 IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">

                <StackLayout>
                    <Entry Placeholder="Заголовок уведомления" 
                           MaxLength="100"
                          Text="{Binding Title}" />
                    <HorizontalStackLayout 
                            IsVisible="{Binding Title.Length, Converter={StaticResource IsNotZeroConverter}}">
                        <Label Text="{Binding Title.Length}"
                          TextColor="{Binding Title.Length, 
                                  Converter={StaticResource CounterColorConverter}, 
                                  ConverterParameter=100}"/>
                        <Label Text="/"
                           TextColor="{Binding Title.Length, 
                                  Converter={StaticResource CounterColorConverter}, 
                                  ConverterParameter=100}"/>
                        <Label Text="100"
                           TextColor="{Binding Title.Length, 
                                  Converter={StaticResource CounterColorConverter}, 
                                  ConverterParameter=100}"/>
                    </HorizontalStackLayout>

                </StackLayout>


                <StackLayout>
                    <Editor Placeholder="Текст уведомления..." 
                            Text="{Binding Message}"
                            HeightRequest="120" 
                            MaxLength="1000"/>
                    <HorizontalStackLayout 
                        IsVisible="{Binding Message.Length, Converter={StaticResource IsNotZeroConverter}}">
                        <Label Text="{Binding Message.Length}"
                             TextColor="{Binding Message.Length, 
                                  Converter={StaticResource CounterColorConverter}, 
                                  ConverterParameter=1000}"/>
                        <Label Text="/"
                               TextColor="{Binding Message.Length, 
                                Converter={StaticResource CounterColorConverter}, 
                                ConverterParameter=1000}"/>
                        <Label Text="1000"
                                TextColor="{Binding Message.Length, 
                                 Converter={StaticResource CounterColorConverter}, 
                                 ConverterParameter=1000}"/>
                    </HorizontalStackLayout>

                </StackLayout>


                <HorizontalStackLayout Spacing="5" 
                       HorizontalOptions="Start">
                    <Label Text="Разрешить обсуждения:"
                           VerticalOptions="Center"/>
                    <Switch IsToggled="{Binding AllowReplies}"
                            VerticalOptions="Center"
                            Style="{StaticResource ThemeSwitchStyle}"/>

                </HorizontalStackLayout>

                <Image Source="{Binding ImagePreview}"
                           HeightRequest="250"
                           IsVisible="{Binding ImagePreview, Converter={StaticResource NullToVisibilityConverter}}"/>

                <Image HeightRequest="250"
                       IsVisible="{Binding IsShowExistingImage}">
                    <Image.Source>
                        <UriImageSource Uri="{Binding ImageUrl}"/>
                    </Image.Source>
                </Image>

                <Button Text="Выбрать изображение" 
                           Command="{Binding SelectImageCommand}"
                           BackgroundColor="#F18F01"
                           TextColor="White"
                           IsVisible="{Binding IsImageExist, Converter={StaticResource InverseBoolConverter}}"
                           IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Text="Изменить изображение" 
                           Command="{Binding SelectImageCommand}"
                           BackgroundColor="#F18F01"
                           TextColor="White"
                           IsVisible="{Binding IsImageExist}"
                           IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Text="Удалить изображение" 
                           Command="{Binding ClearImageCommand}"
                           BackgroundColor="Red"
                           TextColor="White"
                           IsVisible="{Binding ImagePreview, Converter={StaticResource NullToVisibilityConverter}}"
                           IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>

                <Picker Title="Тип уведомления"
                        ItemsSource="{Binding NotificationTypes}"
                        SelectedItem="{Binding SelectedType}"
                        ItemDisplayBinding="{Binding DisplayValue}"/>

                <Picker Title="Кому отправить"
                        ItemsSource="{Binding AudienceTypes}"
                        SelectedItem="{Binding SelectedAudience}"
                        ItemDisplayBinding="{Binding DisplayValue}"/>


                <!-- Фильтрация групп -->
                <Border IsVisible="{Binding ShowGroupSelector}"
                        Style="{StaticResource frame}"
                        Padding="10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Фильтрация групп:" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="#2E86AB"/>

                        <Entry Placeholder="Название группы"
                           Text="{Binding GroupFilter.Name}" />

                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Применить фильтр"
                                Command="{Binding ApplyGroupFiltersCommand}"
                                BackgroundColor="#2E86AB"
                                TextColor="White"
                                CornerRadius="5"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>

                            <Button Text="Сбросить"
                                Command="{Binding ResetGroupFiltersCommand}"
                                BackgroundColor="#6c757d"
                                TextColor="White"
                                CornerRadius="5"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>
                        </HorizontalStackLayout>

                        <Label Text="Выберите группу:" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="#2E86AB"/>
                        <Picker Title="Группа"
                            ItemsSource="{Binding Groups}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedGroup}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Фильтрация пользователей -->
                <Border IsVisible="{Binding ShowUserSelector}"
                   Style="{StaticResource frame}"
                   Padding="10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Фильтрация пользователей:" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#2E86AB"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10">
                            <Entry Placeholder="Имя"
                               Text="{Binding UserFilter.FirstName}"
                               Grid.Column="0" Grid.Row="0"/>

                            <Entry Placeholder="Фамилия"
                               Text="{Binding UserFilter.LastName}"
                               Grid.Column="1" Grid.Row="0"/>

                            <Entry Placeholder="Email"
                               Text="{Binding UserFilter.Email}"
                               Grid.Column="0" Grid.Row="1"/>

                            <Entry Placeholder="Номер телефона"
                               Text="{Binding UserFilter.PhoneNumber}"
                               Grid.Column="1" Grid.Row="1"/>
                        </Grid>

                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Применить фильтр"
                                Command="{Binding ApplyUserFiltersCommand}"
                                BackgroundColor="#2E86AB"
                                TextColor="White"
                                CornerRadius="5"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>

                            <Button Text="Сбросить"
                                Command="{Binding ResetUserFiltersCommand}"
                                BackgroundColor="#6c757d"
                                TextColor="White"
                                CornerRadius="5"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>
                        </HorizontalStackLayout>

                        <Label Text="Выберите пользователя:" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="#2E86AB"/>
                        <Picker Title="Пользователь"
                            ItemsSource="{Binding Users}"
                            ItemDisplayBinding="{Binding FullName}"
                            SelectedItem="{Binding SelectedUser}"
                            IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Детальная информация о пользователе -->
                <Border IsVisible="{Binding IsUserSelected}"
                     Style="{StaticResource frame}"
                     Padding="15"
                     Margin="0,5,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Детальная информация"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#2E86AB"/>

                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Имя: " 
                                         FontAttributes="Bold"/>
                                    <Span Text="{Binding SelectedUser.FirstName}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Фамилия: " 
                                     FontAttributes="Bold"/>
                                    <Span Text="{Binding SelectedUser.LastName}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Email: " 
                                     FontAttributes="Bold"/>
                                    <Span Text="{Binding SelectedUser.Email}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Роль: " 
                                    FontAttributes="Bold"/>
                                    <Span Text="{Binding SelectedUser.Role, Converter={StaticResource RoleToRussianConverter}}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label IsVisible="{Binding SelectedUser.Role, Converter={StaticResource IsStudentRoleConverter}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Группа: " 
                                     FontAttributes="Bold"/>
                                    <Span Text="{Binding SelectedUser.Group, TargetNullValue='Не указана'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Телефон: " 
                                      FontAttributes="Bold"/>
                                    <Span Text="{Binding SelectedUser.PhoneNumber, TargetNullValue='Не указан'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Разделитель -->
                        <BoxView HeightRequest="1" 
                             Color="{AppThemeBinding Light='#E0E0E0', Dark='#404040'}"
                             Margin="0,5,0,5"/>

                        <!-- Информационная метка -->
                        <Label Text="Уведомление будет отправлено только выбранному пользователю"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light='#6c757d', Dark='#9e9e9e'}"
                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Индикатор загрузки -->
                <ActivityIndicator IsVisible="{Binding IsUpdating}"
                              IsRunning="{Binding IsUpdating}"
                              HorizontalOptions="Center"
                              Color="#2E86AB"/>

                <Button Text="Изменить уведомление" 
                    Command="{Binding UpdateCommand}"
                    BackgroundColor="#2E86AB"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,20,0,0"
                    IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}"/>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>