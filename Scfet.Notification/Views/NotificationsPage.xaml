<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scfet.Notification.Views.NotificationsPage"
             xmlns:vm="clr-namespace:Scfet.Notification.ViewModels"
             xmlns:models="clr-namespace:Scfet.Notification.Models"
             xmlns:views="clr-namespace:Scfet.Notification.Views"
             xmlns:converters="clr-namespace:Scfet.Notification.Converters"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:DataType="vm:NotificationsViewModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="frame" TargetType="Border">
                <Setter Property="BackgroundColor">
                    <Setter.Value>
                        <AppThemeBinding Light="#F0F0F0"
                           Dark="#2A2A2A" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid>

        <!-- Ошибка загрузки уведомлений -->
        <StackLayout HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         IsVisible="{Binding IsStartLoadNotificationsFailed}">

            <Image Source="no_wifi.png" HeightRequest="200" WidthRequest="200" Margin="0,0,0,70"/>
            <Label Text="Не удалось загрузить уведомления" FontSize="16"/>
            <Label Text="Проверьте подключение к интернету" FontSize="16"/>
            <Button Text="Перезагрузить"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#2E86AB"
                    TextColor="White"
                    CornerRadius="5"
                    Margin="0,10,0,0"/>
        </StackLayout>

        <!-- Состояние загрузки -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Spacing="20">
            
            <ActivityIndicator IsRunning="True" 
                             Color="#2E86AB"
                             HeightRequest="50"
                             WidthRequest="50" />
            <Label Text="Загрузка уведомлений..." 
                               FontSize="16"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Основной контент -->
        <ScrollView IsVisible="{Binding IsStartLoadNotificationsFailed, Converter={StaticResource InverseBoolConverter}}"
                    x:Name="MainScrollView">
            <StackLayout Padding="10,0"
                         IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                         x:Name="contentLayout">

                <StackLayout Spacing="20">
                    <!-- Фильтрация уведомлений-->
                    <Border 
                        Style="{StaticResource frame}"
                        Padding="10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Фильтрация уведомлений:" 
                                    FontSize="14" 
                                    FontAttributes="Bold" />

                            <Picker Title="Размер страницы"
                                    ItemsSource="{Binding PageSizes}"
                                    SelectedItem="{Binding Filter.PageSize}" />

                            <Picker Title="Сортировать По:"
                                    ItemsSource="{Binding SortByItems}"
                                    SelectedItem="{Binding SelectedSortBy}"
                                    ItemDisplayBinding="{Binding DisplayName}"/>

                            <Picker Title="Упорядочить:" 
                                    ItemsSource="{Binding SortOrderItems}"
                                    SelectedItem="{Binding SelectedSortOrder}"
                                        ItemDisplayBinding="{Binding DisplayName}"/>

                            <Picker Title="Выберите период"
                                    ItemsSource="{Binding DateRangeOptions}"
                                    SelectedItem="{Binding SelectedDateRange}"
                                    ItemDisplayBinding="{Binding DisplayName}"/>

                            <Grid ColumnDefinitions="Auto,Auto" 
                                    ColumnSpacing="5"
                                    IsVisible="{Binding ShowCustomDateInput}">
                                <StackLayout Grid.Column="0" Padding="10">
                                    <Label Text="С:"/>
                                    <DatePicker Date="{Binding SelectedStartDate}"/>
                                </StackLayout>
                                <StackLayout Grid.Column="1" Padding="10">
                                    <Label Text="По:"/>
                                    <DatePicker Date="{Binding SelectedEndDate}"/>
                                </StackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Применить фильтр"
                                    Command="{Binding ApplyFiltersCommand}"
                                    BackgroundColor="#2E86AB"
                                    TextColor="White"
                                    CornerRadius="5"
                                    HorizontalOptions="FillAndExpand"
                                    IsEnabled="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Text="Сбросить"
                                    Command="{Binding ResetFiltersCommand}"
                                    BackgroundColor="#6c757d"
                                    TextColor="White"
                                    CornerRadius="5"
                                    HorizontalOptions="FillAndExpand"
                                    IsEnabled="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Список уведомлений -->
                    <CollectionView ItemsSource="{Binding Notifications}"
                                    SelectionMode="None">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" 
                                        VerticalOptions="Center"
                                        Spacing="20"
                                        Padding="30">
                                <Label Text="📭" 
                                        FontSize="48" 
                                        HorizontalOptions="Center" />
                                <Label Text="Нет уведомлений" 
                                        FontSize="18" 
                                    HorizontalOptions="Center" />
                                <Label Text="Здесь будут появляться новые уведомления от преподавателей и администрации" 
                                    FontSize="14" 
                                        TextColor="Gray"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Notification">
                                <Border Padding="15" 
                                        Margin="10,5"
                                        BackgroundColor="{Binding Type, Converter={StaticResource NotificationTypeToColorConverter}}"
                                        >
                                    <Border.Stroke>
                                        <MultiBinding Converter="{StaticResource BorderStrokeToColorConverter}">
                                            <Binding Source="{RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}" 
                                                     Path="CurrentUserId"/>
                                            <Binding Path="SenderId"/>
                                        </MultiBinding>
                                    </Border.Stroke>
                                    
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                            ColumnDefinitions="*,Auto"
                                            RowSpacing="7"
                                            ColumnSpacing="5">

                                        <!-- Дата и иконка закладки -->
                                        <Grid Grid.Row="0" 
                                              Grid.ColumnSpan="2" 
                                              ColumnDefinitions="*,Auto,Auto">
                                            <!-- Метка личного сообщения-->
                                            <Border IsVisible="{Binding IsPersonal}"
                                                    BackgroundColor="#FFE5E5"
                                                    Padding="8,3"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Center"
                                                    Grid.Column="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="🔒" FontSize="9"/>
                                                    <Label Text="личное"
                                                           FontSize="9"
                                                           TextColor="{AppThemeBinding Light='#E74C3C', Dark='#FF8A7A'}"
                                                           FontAttributes="Bold"/>
                                                </HorizontalStackLayout>
                                            </Border>

                                            <!-- Дата -->
                                            <Label Grid.Column="1" 
                                                   Text="{Binding CreatedAt, Converter={StaticResource RelativeTimeConverter}}" 
                                                   FontSize="12"
                                                   VerticalOptions="Center"/>

                                            <!-- Закладка -->
                                            <ImageButton Grid.Column="2"
                                                         Source="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteIconConverter}}"
                                                         WidthRequest="15"
                                                         HeightRequest="15"
                                                         BackgroundColor="Transparent"
                                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, 
                                                                           Path=ToggleFavoriteCommand}"
                                                         CommandParameter="{Binding .}"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="Center"
                                                         Padding="8"/>
                                        </Grid>

                                        <!-- Отправитель -->
                                        <Grid
                                            Grid.Row="1" 
                                            Grid.Column="0"
                                            ColumnSpacing="3"
                                                RowSpacing="6"
                                            ColumnDefinitions="auto,auto,auto,auto"
                                            RowDefinitions="*,*"
                                            VerticalOptions="Center">

                                            <!-- Аватар/иконка -->
                                            <Border BackgroundColor="#E8F0FE"
                                                    Style="{StaticResource card_avatar}"
                                                    Grid.Column="0"
                                                    HorizontalOptions="Start"
                                                    Grid.Row="0">
                                                <ff:CachedImage 
                                                    Source="{Binding SenderAvatarUrl}"
                                                    Aspect="AspectFill"
                                                    DownsampleToViewSize="True"
                                                    FadeAnimationEnabled="False"
                                                    LoadingPlaceholder="placeholder.png"
                                                    ErrorPlaceholder="placeholder.png"
                                                    RetryCount="2">
                                                </ff:CachedImage>
                                            </Border>

                                            <!-- Имя отправителя -->
                                            <Label Text="{Binding SenderName}" 
                                                    FontSize="12" 
                                                    FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light='#2C3E50', Dark='#ECF0F1'}"
                                                    VerticalOptions="Center"
                                                   HorizontalOptions="Start"
                                                   MaximumWidthRequest="170"
                                                   LineBreakMode="TailTruncation"
                                                   Grid.Column="0"
                                                   Grid.Row="1"/>

                                            <!-- Разделитель -->
                                            <Label Text="·" 
                                                    FontSize="14"
                                                    TextColor="{AppThemeBinding Light='#BDC3C7', Dark='#7F8C8D'}"
                                                    VerticalOptions="Center"
                                                    Grid.Column="2"
                                                   Grid.Row="1"/>

                                            <!-- Роль с цветным фоном -->
                                            <Border BackgroundColor="{Binding SenderRole, Converter={StaticResource RoleToColorConverter}}"
                                                    Padding="8,3"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Center"
                                                    Grid.Column="3"
                                                    Grid.Row="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding SenderRole, Converter={StaticResource RoleToRussianConverter}}"
                                                        FontSize="10"
                                                        TextColor="White"
                                                        FontAttributes="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Изображение -->
                                        <ff:CachedImage 
                                                Source="{Binding ImageUrl}"
                                                Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                HeightRequest="350"
                                                IsVisible="{Binding ImageUrl, Converter={StaticResource StringNotEmptyConverter}}"
                                                DownsampleToViewSize="True"
                                                FadeAnimationEnabled="False"
                                                LoadingPlaceholder="placeholder.png"
                                                ErrorPlaceholder="placeholder.png"
                                                RetryCount="2">
                                        </ff:CachedImage>

                                        <!-- Заголовок -->
                                        <Label Grid.Row="3" 
                                                Grid.Column="0"
                                                Text="{Binding Title}" 
                                                FontSize="16" 
                                                FontAttributes="Bold" />

                                        <!-- Сообщение -->
                                        <Label Grid.Row="4" 
                                                Grid.ColumnSpan="2"
                                                Text="{Binding Message}" 
                                                FontSize="14" 
                                                LineBreakMode="WordWrap" />

                                        <!-- Статус прочтения -->
                                        <Label Grid.Row="5" 
                                                Grid.Column="0"
                                                Text="{Binding IsRead, Converter={StaticResource ReadStatusConverter}}"
                                                FontSize="12" />

                                        <!-- Кнопка обсудить -->
                                        <Button Grid.Row="6" 
                                                HorizontalOptions="Start"
                                                WidthRequest="100"
                                                MinimumHeightRequest="40"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path = GoToRepliesPageCommand}"
                                                CommandParameter="{Binding Id}"
                                                Text="Обсудить" 
                                                TextColor="{AppThemeBinding Light=White, Dark=White}"
                                                FontSize="12"
                                                IsVisible="{Binding AllowReplies}"
                                                BackgroundColor="#2E86AB"/>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, 
                                            Path=MarkAsReadCommand}"
                                                                CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Действия -->
                <Grid IsVisible="{Binding IsPaginationEnable}">

                    <!-- Состояние загрузки пагинации-->
                    <VerticalStackLayout IsVisible="{Binding IsPagination}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Spacing="20">
                        <ActivityIndicator IsRunning="True" 
                                                    Color="{StaticResource PrimaryColor}"
                                                    HeightRequest="50"
                                                    WidthRequest="50" />
                        <Label Text="Загрузка уведомлений..." 
                                       FontSize="16"
                                       HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Кнопка Загрузить еще -->
                    <Grid Margin="0,10,0,0" ColumnDefinitions="*"
                                 IsVisible="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}">

                        <Button Grid.Column="0" 
                                        Text="Загрузить еще" 
                                        TextColor="{AppThemeBinding Light=White, Dark=White}"
                                        Command="{Binding LoadNotificationsPaginationCommand}"
                                        BackgroundColor="{StaticResource PrimaryColor}"/>
                    </Grid>
                </Grid>

            </StackLayout>
        </ScrollView>

        <!-- Контейнер для плавающих кнопок -->
        <VerticalStackLayout
                        VerticalOptions="End"
                        HorizontalOptions="End"
                        Margin="20"
                        Spacing="10"
                        IsVisible="{Binding IsShowScrollButtons}">   

            <!-- Кнопка вверх -->
            <Button 
                x:Name="scrollToTopButton"
                Text="↑"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{StaticResource PrimaryColor}"
                TextColor="White"
                FontSize="20"
                IsVisible="false"/>

            <!-- Кнопка вниз -->
            <Button 
                x:Name="scrollToBottomButton"
                Text="↓"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{StaticResource PrimaryColor}"
                FontSize="20"
                TextColor="White"
                IsVisible="False"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>