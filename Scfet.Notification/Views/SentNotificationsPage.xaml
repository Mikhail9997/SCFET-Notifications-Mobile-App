<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scfet.Notification.Views.SentNotificationsPage"
             xmlns:vm="clr-namespace:Scfet.Notification.ViewModels"
             xmlns:models="clr-namespace:Scfet.Notification.Models"
             x:DataType="vm:SentNotificationsViewModel"
             xmlns:views="clr-namespace:Scfet.Notification.Views"
             Title="Отправленные уведомления">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="frame" TargetType="Border">
                <Setter Property="BackgroundColor">
                    <Setter.Value>
                        <AppThemeBinding Light="#F0F0F0"
                           Dark="#2A2A2A" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid>

        <!-- Ошибка загрузки уведомлений -->
        <StackLayout HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         IsVisible="{Binding IsStartLoadNotificationsFailed}">

            <Image Source="no_wifi.png" HeightRequest="200" WidthRequest="200" Margin="0,0,0,70"/>
            <Label Text="Не удалось загрузить уведомления" FontSize="16"/>
            <Label Text="Проверьте подключение к интернету" FontSize="16"/>
            <Button Text="Перезагрузить"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#2E86AB"
                    TextColor="White"
                    CornerRadius="5"
                    Margin="0,10,0,0"/>
        </StackLayout>

        <!-- Состояние загрузки -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Spacing="20">
            <ActivityIndicator IsRunning="True" 
                             Color="#2E86AB"
                             HeightRequest="50"
                             WidthRequest="50" />
            <Label Text="Загрузка уведомлений..." 
                    FontSize="16"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Основной контент -->
        <ScrollView IsVisible="{Binding IsStartLoadNotificationsFailed, Converter={StaticResource InverseBoolConverter}}"
                    x:Name="MainScrollView">
            <StackLayout Padding="5,0" 
                         Spacing="10"
                         x:Name="contentLayout"
                         IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <Grid>
                    <StackLayout Spacing="20">
                        
                        <!-- Фильтрация уведомлений-->
                        <Border 
                            Style="{StaticResource frame}"
                           Padding="10">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="Фильтрация уведомлений:" 
                                   FontSize="14" 
                                   FontAttributes="Bold" />

                                <Picker Title="Размер страницы:"
                                    ItemsSource="{Binding PageSizes}"
                                    SelectedItem="{Binding Filter.PageSize}" />

                                <Picker Title="Сортировать По:"
                                    ItemsSource="{Binding SortByItems}"
                                    SelectedItem="{Binding SelectedSortBy}"
                                    ItemDisplayBinding="{Binding DisplayName}"/>

                                <Picker Title="Упорядочить:" 
                                    ItemsSource="{Binding SortOrderItems}"
                                    SelectedItem="{Binding SelectedSortOrder}"
                                    ItemDisplayBinding="{Binding DisplayName}"/>

                                <Picker Title="Выберите период"
                                    ItemsSource="{Binding DateRangeOptions}"
                                    SelectedItem="{Binding SelectedDateRange}"
                                    ItemDisplayBinding="{Binding DisplayName}"/>

                                <Grid ColumnDefinitions="Auto,Auto" 
                                  ColumnSpacing="5"
                                  IsVisible="{Binding ShowCustomDateInput}">
                                    <StackLayout Grid.Column="0" Padding="10">
                                        <Label Text="С:"/>
                                        <DatePicker Date="{Binding SelectedStartDate}"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="1" Padding="10">
                                        <Label Text="По:"/>
                                        <DatePicker Date="{Binding SelectedEndDate}"/>
                                    </StackLayout>
                                </Grid>

                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Применить фильтр"
                                        Command="{Binding ApplyFiltersCommand}"
                                        BackgroundColor="#2E86AB"
                                        TextColor="White"
                                        CornerRadius="5"
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}"/>

                                    <Button Text="Сбросить"
                                        Command="{Binding ResetFiltersCommand}"
                                        BackgroundColor="#6c757d"
                                        TextColor="White"
                                        CornerRadius="5"
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Список уведомлений -->
                        <CollectionView ItemsSource="{Binding Notifications}"
                            SelectionMode="None">

                            <CollectionView.EmptyView>
                                <VerticalStackLayout HorizontalOptions="Center" 
                                       VerticalOptions="Center"
                                       Spacing="20"
                                       Padding="40">
                                    <Label Text="📤" 
                                         FontSize="48" 
                                         HorizontalOptions="Center" />
                                    <Label Text="Нет отправленных уведомлений" 
                                        FontSize="18" 
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SentNotification">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItem Text="Удалить" 
                                                       BackgroundColor="Red"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type views:SentNotificationsPage}}, Path=BindingContext.DeleteNotificationCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Изменить" 
                                                       BackgroundColor="Orange"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type views:SentNotificationsPage}}, Path=BindingContext.EditNotificationCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeView.RightItems>

                                        <Border Padding="15" 
                                           Margin="10,5"
                                           BackgroundColor="{Binding Type, Converter={StaticResource NotificationTypeToColorConverter}}">

                                            <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              RowSpacing="10">

                                                <Image Grid.Row="0"
                                                   Grid.ColumnSpan="2"
                                                   HeightRequest="350"
                                                   IsVisible="{Binding ImageUrl, Converter={StaticResource StringNotEmptyConverter}}">
                                                    <Image.Source>
                                                        <UriImageSource Uri="{Binding ImageUrl}"/>
                                                    </Image.Source>
                                                </Image>

                                                <Label Grid.Column="0" 
                                                   Grid.Row="1"
                                                   Text="{Binding Title}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" />

                                                <Label Grid.Column="1" 
                                                   Grid.Row="1"
                                                   Text="{Binding FormattedDate}" 
                                                   FontSize="12" 
                                                    FontAttributes="Bold" />

                                                <Label Grid.Column="0" 
                                                   Grid.ColumnSpan="2"
                                                   Grid.Row="2"
                                                   Text="{Binding Message}" 
                                                   FontSize="14" 
                                                   Margin="0,5,0,0"
                                                   LineBreakMode="TailTruncation" />

                                                <ProgressBar Grid.Column="0" 
                                                 Grid.ColumnSpan="2"
                                                 Grid.Row="3"
                                                 Progress="{Binding ReadPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                                 ProgressColor="{Binding ReadPercentage, Converter={StaticResource PercentageToColorConverter}}"            
                                                 Margin="0,10,0,5" />

                                                <Label Grid.Column="0" 
                                                   Grid.ColumnSpan="2"
                                                   Grid.Row="4"
                                                   Text="{Binding ReadReceivers, StringFormat='{0} прочитано'}" 
                                                   FontSize="12" 
                                                   HorizontalOptions="Start" />

                                                <Label Grid.Column="1" 
                                                   Grid.Row="5"
                                                   Text="{Binding ReadPercentage, StringFormat='{0:F1}%'}" 
                                                   FontSize="12" 
                                                   HorizontalOptions="End" />

                                            </Grid>

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type views:SentNotificationsPage}}, Path=BindingContext.ShowDetailsCommand}"
                                                          CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                        </Border>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                </Grid>

                <!-- Действия -->
                <Grid IsVisible="{Binding IsPaginationEnable}">

                    <!-- Состояние загрузки пагинации-->
                    <VerticalStackLayout IsVisible="{Binding IsPagination}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Spacing="20">
                        <ActivityIndicator IsRunning="True" 
                             Color="#2E86AB"
                             HeightRequest="50"
                             WidthRequest="50" />
                        <Label Text="Загрузка уведомлений..." 
                               FontSize="16"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Кнопка Загрузить еще -->
                    <Grid Margin="0,10,0,0" ColumnDefinitions="*"
                      IsVisible="{Binding IsPagination, Converter={StaticResource InverseBoolConverter}}">

                        <Button Grid.Column="0" 
                            Text="Загрузить еще" 
                            Command="{Binding LoadNotificationsPaginationCommand}"
                            BackgroundColor="#2E86AB"/>
                    </Grid>
                </Grid>
            </StackLayout>
        </ScrollView>

        <!-- Контейнер для плавающих кнопок -->
        <VerticalStackLayout
                        VerticalOptions="End"
                        HorizontalOptions="End"
                        Margin="20"
                        Spacing="10"
                        IsVisible="{Binding IsShowScrollButtons}">

            <!-- Кнопка вверх -->
            <Button 
                x:Name="scrollToTopButton"
                Text="↑"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="#2E86AB"
                TextColor="White"
                FontSize="20"
                IsVisible="false"/>

            <!-- Кнопка вниз -->
            <Button 
                x:Name="scrollToBottomButton"
                Text="↓"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="#2E86AB"
                FontSize="20"
                TextColor="White"
                IsVisible="False"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>